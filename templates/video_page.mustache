<main class='evg-video-page'>
    <div class='evg-video-page-heading'>
        <a href='{{backurl}}' class='evg-video-back'>
            <span aria-hidden='true'>&larr;</span> {{#str}} back, core {{/str}}
        </a>
    </div>

    <div class='evg-video-player'>
        <iframe
            src='{{embedurl}}'
            title='{{title}}'
            sandbox='allow-scripts allow-same-origin allow-presentation'
            referrerpolicy='strict-origin-when-cross-origin'
            allow='accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share'
            allowfullscreen>
        </iframe>
    </div>
</main>
